# Copy this file to `.env.local` and fill in the values. `.env.local` is never committed.
# On Vercel, add the same variables in Project → Settings → Environment Variables.

# Supabase (Project Settings → API). The URL and anon key are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Full database access, bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_, never paste in chat, never commit.
SUPABASE_SERVICE_ROLE_KEY=
