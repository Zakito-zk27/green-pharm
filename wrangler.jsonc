// Cloudflare Workers settings for the store (built with OpenNext: `npm run deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "green-pharm",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "green-pharm" }],
  "d1_databases": [
    // Orders, products, settings. No database_id on purpose: the first deploy creates the
    // database in whichever Cloudflare account publishes the site (Wrangler auto-provisioning).
    {
      "binding": "DB",
      "database_name": "green-pharm-db",
    },
    // Product photos and logos (used when no R2 bucket is set up, R2 needs a bank card).
    {
      "binding": "MEDIA_DB",
      "database_name": "green-pharm-media",
    },
  ],
  // Optional: photos in R2 instead of MEDIA_DB. Uncomment after `npx wrangler r2 bucket create green-pharm-media`.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "green-pharm-media" }],
}
